#!/usr/bin/env python3
"""Launcher: runs Keyglow from the source tree, or the installed package."""
import os
import sys

source_root = os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir)
if os.path.isfile(os.path.join(source_root, "keyglow", "__init__.py")):
    sys.path.insert(0, os.path.abspath(source_root))

from keyglow.cli import main  # noqa: E402

sys.exit(main())
